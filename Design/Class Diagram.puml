@startuml
class View{
    + DisplayUI()
    + DisplayEditor()
    + DisplayMapLayer()
    + DisplayInventory()
    + DisplaySettings()
    + DisplaySaveMenu()
    + DisplaySprite()
    + DisplayBackground()
}

class ViewModel {
    + handleInput()
    + updateView()
    + updateModel()
    + openEditor()
}

class Model {
    + gameState
    + currentStage

    + updateGame()
    + loadGame()
    + saveGame()
}

class EditorModel {
    + currentItem
    + currentAnimation

    + createItem()
    + editItem()
    + createAnimation()
    + editAnimation()
}

class AnimationStack {
    - animations
    + addAnimation(animation)
    + playAnimation()
    + stopAnimation()
}


class Character {
    + x
    + y
    + health
    - Inventory

    + move(x, y)
    + take_damage(damage)
    + is_alive()
}

class NPC {
    - dropTable
}

class AnimationEditor{

}

class ItemFactory {
    + createItem(itemType)
}

abstract class Inventory {
    - items
    + addItem(item)
    + removeItem(item)
    + getItems()
}

class Shop {
    - items
    + buyItem(item)
    + sellItem(item)
    + displayItems()
}

class Chests {
    - items
    - isOpen
    + openChest()
    + getItems()
}


class ItemFactory {
    + createItem(itemType)
}

class CharacterMovement {
    + speed
    + moveUp()
    + moveDown()
    + moveLeft()
    + moveRight()
}

class EnemyAI {
    + detectPlayer()
    + moveTowardPlayer()
    + chooseAction()
    + attackPlayer()
}


class ExporterFactory {
    + createExporter(fileType)
    + exportData()
}

class ParserFactory {
    + createParser(fileType)
    + parseData()
}

class AnimationAttack {
    + playAttack()
    + resetAttack()
}

class ExportAnimation {
    + animationData
    + fileName
    + exportAnimation()
}

class ExportItem {
    + exportItem()
}

class Stage {
    + currentLevel
    + loadStage()
    + updateStage()
}

class IsoGrid {
    + rows
    + columns
    + tileWidth
    + tileHeight
}

class TileData {
    + tileType
    + walkable
    + movementCost
    + getTileType()
}

class Armor {
    + defense
    + durability
    + equip()
    + takeDamage(damage)
}

class SaveGame {
    + saveGame()
    + loadGame()
}

class Modifiers {
    + modifierType
    + duration
    + applyModifier()
    + removeModifier()
}


class AttackSequence {
    + attack()
    + calculateDamage()
}

class AOE {

}

class Melee {
    + damage
    + attackRange
    + attack()
}

class Range {
    + damage
    + attackRange
    + ammo
    + attack()
    + reload()
}

class Defence {
    + defenseValue
    + durability
    + defend()
}

abstract class SpriteEntity {
    + x
    + y
    + sprite
    + health

    + update()
    + render()
}

class ParseSave {
    + parseSave()
}

class ParseAnimationJSON {

}

abstract class Weapon {
    + damage
    + range
    + attack()
}

View --> ViewModel
ViewModel --> Model
ViewModel --> EditorModel

EditorModel ..> ExporterFactory
EditorModel ..> ParserFactory
EditorModel --> ItemEditor
EditorModel --> AnimationEditor
EditorModel ..> ItemFactory

Model --> Stage
Model --> Character
Model --> NPC
Model --> SaveGame
Model ..> ParserFactory
Model --> Chests
Model --> Shop
Model ..> ItemFactory

Character --|> SpriteEntity
Character --> CharacterMovement
Character --> Modifiers
Character --|> Inventory


NPC --|> SpriteEntity
NPC --> EnemyAI

SpriteEntity --> AnimationAttack
SpriteEntity --> AnimationStack
SpriteEntity --> Armor
SpriteEntity --> AttackSequence


Shop --|> Inventory

Chests --|> Inventory

ExporterFactory ..> ExportItem
ExporterFactory ..> ExportAnimation

ItemFactory ..> Weapon

Weapon --> Melee
Weapon --> Range
Weapon --> AOE
Weapon --> Defence

ParserFactory ..> ParseItemJSON
ParserFactory ..> ParseAnimationJSON
ParserFactory ..> ParseSave

Stage --> IsoGrid
Stage --> TileData
@enduml
